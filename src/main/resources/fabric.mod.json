{
  "schemaVersion": 1,
  "id": "water_imbued_enchantment",
  "version": "${version}",

  "name": "Water Imbued Enchantment",
  "description": "This mod adds two new enchantments that allow the use of riptide and channeling without the need of water, rain or thunderstorm",
  "authors": [
    "themoonflowerteam",
    "driquelme2699"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/TheMoonflowerTeam/Water-Imbued-Enchantment/tree/1.18.1-Fabric"
  },

  "license": "MIT License",
  "icon": "assets/water_imbued_enchantment/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.moonflower.waterimbuedenchantmentmod.WaterImbuedEnchantmentMod"
    ],
    "modmenu": [
      "net.moonflower.waterimbuedenchantmentmod.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    "water_imbued_enchantment.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.14.6",
    "fabric": "*",
    "minecraft": ">=1.18 <1.18.2",
    "java": ">=17"
  },
  "suggests": {
    "another-mod": "*"
  }
}
